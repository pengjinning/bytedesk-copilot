{
  "name": "bytedesk-copilot",
  "displayName": "BytedeskCopilot",
  "description": "Integrates Z.ai models (GLM-4.5, GLM-4.6, GLM-4.7, GLM-5, GLM-5-Turbo, GLM-5.1, GLM-5.2, GLM-5.3, GLM-5V-Turbo, GLM-5-Code) into VS Code Copilot Chat with vision support and thinking process display",
  "version": "0.11.0",
  "publisher": "bytedesk-copilot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ryosuke-Asano/zai-provider-extension"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "ai",
    "chat",
    "copilot",
    "zai",
    "glm",
    "llm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "bytedesk-copilot",
        "displayName": "BytedeskCopilot",
        "managementCommand": "bytedesk-copilot.manage"
      }
    ],
    "languageModelTools": [
      {
        "name": "bytedesk-copilot_analyze_image",
        "displayName": "Analyze Image with BytedeskCopilot",
        "modelDescription": "Analyze an image using Z.ai Vision model. Use this tool when you need to understand or describe the content of an image, extract text from images (OCR), or answer questions about visual content.",
        "icon": "$(eye)"
      }
    ],
    "commands": [
      {
        "command": "bytedesk-copilot.manage",
        "title": "Manage BytedeskCopilot Provider",
        "category": "BytedeskCopilot"
      },
      {
        "command": "bytedesk-copilot.welcome",
        "title": "Welcome (Getting Started)",
        "category": "BytedeskCopilot"
      }
    ],
    "configuration": {
      "title": "BytedeskCopilot",
      "properties": {
        "bytedesk-copilot.enableThinking": {
          "type": "boolean",
          "default": true,
          "description": "Enable thinking/reasoning process display in chat responses. When disabled, the model's reasoning will not be shown. Note: GLM-5.3 always thinks server-side; disabling this setting only hides the thinking display."
        },
        "bytedesk-copilot.reasoningEffort": {
          "type": "string",
          "enum": ["default", "low", "high", "max"],
          "default": "default",
          "enumDescriptions": [
            "Omit the parameter and use the server default (max)",
            "Lightweight reasoning",
            "Enhanced reasoning",
            "Deep reasoning (recommended for coding)"
          ],
          "description": "Reasoning effort for models that support reasoning levels (GLM-5.3). 'default' omits the parameter so the server default (max) applies. Ignored by models without reasoning effort support."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "download-api": "dts dev",
    "postdownload-api": "dts main",
    "postinstall": "npm run download-api",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "package": "vsce package --no-yarn",
    "publish": "vsce publish --no-yarn"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.1.0",
    "@types/vscode": "^1.104.0",
    "@vscode/dts": "^0.4.1",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.1"
  }
}
